# Copy to .env and fill in the three values. Git ignores .env, and the pipeline
# never prints them or writes them anywhere.
#
# Gemini API key:      https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cloudflare:          account ID from the dashboard's right-hand sidebar, and
#                      an API token allowed to run Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional. The pipeline uses the FFmpeg that ships with its Python packages,
# which keeps the film the same on every machine. Set this only to use another copy.
# FFMPEG_BIN=
